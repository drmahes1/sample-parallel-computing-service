{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "PCS/GPU",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}",
      "InstanceType": "${aws:InstanceType}"
    },
    "aggregation_dimensions": [["InstanceType"], []],
    "metrics_collected": {
      "nvidia_gpu": {
        "measurement": [
          "utilization_gpu",
          "utilization_memory",
          "memory_total",
          "memory_used",
          "memory_free",
          "temperature_gpu",
          "power_draw"
        ],
        "metrics_collection_interval": 15
      },
      "cpu": {
        "measurement": ["usage_idle", "usage_iowait"],
        "metrics_collection_interval": 300,
        "totalcpu": true
      },
      "mem": {
        "measurement": ["used_percent"],
        "metrics_collection_interval": 300
      }
    }
  }
}
